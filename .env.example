# =============================================================================
# Vivah environment variables: the template.
#
# Copy this file to `.env.local` (git ignores it) and paste your keys there:
#
#     cp .env.example .env.local
#
# Then run `npm run env:vercel` to write `.env.vercel.local`, the file you
# import into Vercel (Project → Settings → Environment Variables → Import .env),
# and `npm run env:functions` for the Edge Function secrets
# (`npx supabase secrets set --env-file supabase/.env.functions.local`).
#
# Two kinds of keys:
#   EXPO_PUBLIC_*  go into the app bundle (phones and the web build). Anyone
#                  can read them, so only public keys belong here.
#   everything else stays on servers: Supabase Edge Function secrets
#                  (`supabase secrets set --env-file`), GitHub Actions secrets
#                  and EAS environment variables. Never prefix a secret with
#                  EXPO_PUBLIC_, and never commit `.env.local`.
#
# Leave a key empty until the phase that needs it (docs/MASTER_PLAN.md §15).
# With EXPO_PUBLIC_BACKEND=mock the app needs none of them.
# =============================================================================

# ─── App (public, bundled) ──────────────────────────────────────────────────

# mock = the on-device demo backend (default); supabase = the real backend (P5).
EXPO_PUBLIC_BACKEND=mock
# Where the web app lives, for share links and the public /w and /rsvp pages.
EXPO_PUBLIC_APP_URL=https://vivah.com.np

# Supabase → Project settings → API. The publishable key (sb_publishable_…),
# or the legacy anon key. Both are safe in the app because RLS guards the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudinary → Dashboard. Uploads are signed by an Edge Function, so only the
# cloud name is public.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# PostHog → Project settings (analytics, feature flags, error tracking).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry → Project settings → Client keys (DSN). Production builds only.
EXPO_PUBLIC_SENTRY_DSN=

# Google Cloud → APIs and services → Credentials. Restrict this key to your
# app ids and web domain, and to the Maps, Places and Geocoding APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare → Turnstile → site key (bot check on web sign-up, RSVP, enquiries).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# EAS project id (expo.dev → project → Overview), used for push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=

# sandbox until Khalti and eSewa merchant accounts are live.
EXPO_PUBLIC_PAYMENT_MODE=sandbox

# Shake-to-report bug inbox for test builds that have no dev server, e.g.
# http://192.168.1.10:8790 while `npm run bugs:inbox` runs on that computer.
# Leave empty: development builds send reports to `npx expo start` itself, and
# store builds hide the feature.
EXPO_PUBLIC_BUG_INBOX_URL=
# on = show shake-to-report in an installed test build (the preview EAS profile
# sets it). Leave empty for store builds.
EXPO_PUBLIC_BUG_REPORTS=

# ─── Supabase (server only) ─────────────────────────────────────────────────

SUPABASE_PROJECT_REF=
# The secret key (sb_secret_…) or legacy service_role key. Bypasses RLS:
# Edge Functions and CI only, never the app.
SUPABASE_SECRET_KEY=
# Connection string for backups (pg_dump) and migrations in CI.
SUPABASE_DB_URL=
# Personal access token for the Supabase CLI in CI (supabase db push).
SUPABASE_ACCESS_TOKEN=

# ─── Auth (server only, set in Supabase → Authentication) ───────────────────

# Google sign-in (optional, free). Email OTP needs no key.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Media (server only) ────────────────────────────────────────────────────

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# After pasting the Cloudinary keys: node scripts/cloudinary-setup.mjs --apply
# (creates the upload presets and named transformations the app uses).

# ─── Email (server only) ────────────────────────────────────────────────────

RESEND_API_KEY=
RESEND_FROM=Vivah <hello@vivah.com.np>

# ─── Rate limits and jobs (server only) ─────────────────────────────────────

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Payments (server only) ─────────────────────────────────────────────────

# Khalti ePayment: the live_secret_key from test-admin.khalti.com (sandbox),
# later from admin.khalti.com with KHALTI_BASE_URL=https://khalti.com/api/v2.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# eSewa ePay v2: with EPAYTEST the published test secret is used, so the
# sandbox needs nothing here. Going live: your product code, secret key and
# ESEWA_BASE_URL=https://epay.esewa.com.np.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
# Extra web hosts the gateways may send people back to, comma-separated
# (e.g. a Vercel preview). The app's own scheme and EXPO_PUBLIC_APP_URL are always allowed.
PAYMENT_RETURN_HOSTS=

# ─── Social hub (server only) ───────────────────────────────────────────────

# Any long random string; signs the connect round trip (social-oauth).
SOCIAL_STATE_SECRET=
# developers.facebook.com → your Business app: Facebook Login for Business,
# Pages, Instagram, WhatsApp. App id and secret; the webhook verify token is
# any string you also type into the app's Webhooks settings.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional: the Facebook Login for Business configuration used for WhatsApp Embedded Signup.
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v21.0
# developers.tiktok.com → your app: Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY until TikTok audits the app, then PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# Approved WhatsApp marketing template for broadcasts: an image header and one body variable.
WHATSAPP_BROADCAST_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Push, builds and monitoring (server and CI only) ───────────────────────

# expo.dev → Access tokens (EAS CI, push with enhanced security).
EXPO_ACCESS_TOKEN=
# Source-map upload for Sentry in EAS builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Shared secret between the database and the notify-fanout Edge Function
# (any long random string; also stored as the Vault secret notify_webhook_secret).
NOTIFY_WEBHOOK_SECRET=
# Cloudflare Turnstile secret, checked by the Edge Function.
TURNSTILE_SECRET_KEY=
# Better Stack heartbeats for the daily keep-alive and the nightly backup
# (GitHub environment secrets; docs/LAUNCH.md §6).
BETTERSTACK_KEEPALIVE_HEARTBEAT_URL=
BETTERSTACK_BACKUP_HEARTBEAT_URL=

# ─── Backups and production web (CI only) ───────────────────────────────────

# Cloudflare R2 bucket for nightly encrypted database backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vivah-backups
# Public key from `age-keygen`; the private key stays offline and is only
# pasted into the `restore` GitHub environment for a rehearsal (docs/LAUNCH.md §5).
BACKUP_AGE_RECIPIENT=
# Cloudflare Pages deploys at commercial launch.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Later (year two) ───────────────────────────────────────────────────────

# Phone OTP through a Nepali SMS gateway (owner decision: email only in year one).
# SPARROW_SMS_TOKEN=
