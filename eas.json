{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_BACKEND": "mock",
        "EXPO_PUBLIC_PAYMENT_MODE": "sandbox"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUG_REPORTS": "on",
        "EXPO_PUBLIC_BUG_INBOX_URL": "http://192.168.1.72:8790"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ROLE_ENTRY": "direct",
        "EXPO_PUBLIC_BUG_REPORTS": "off"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-vendor": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "vendor"
      }
    },
    "preview-vendor": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "vendor"
      }
    },
    "production-freelancer": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "freelancer"
      }
    },
    "preview-freelancer": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "freelancer"
      }
    },
    "production-staff": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "staff"
      }
    },
    "preview-staff": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "staff"
      }
    },
    "production-admin": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "admin"
      }
    },
    "preview-admin": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_APP_EDITION": "admin"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production-vendor": {
      "extends": "production"
    },
    "production-freelancer": {
      "extends": "production"
    },
    "production-staff": {
      "extends": "production"
    },
    "production-admin": {
      "extends": "production"
    }
  }
}
